{
  "$defs": {
    "GraphRef": {
      "additionalProperties": false,
      "description": "Directory (inside an input dataset) holding ``graph.json`` and ``weights.safetensors``.",
      "properties": {
        "input": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Input",
          "type": "string"
        },
        "path": {
          "default": ".",
          "pattern": "^[A-Za-z0-9_.\\-*?\\[\\]][A-Za-z0-9_.\\-*?\\[\\]/]{0,254}$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "input"
      ],
      "title": "GraphRef",
      "type": "object"
    },
    "ImageFolder": {
      "additionalProperties": false,
      "description": "Classification images in one sub-directory per class (classes are declared, hence public).",
      "properties": {
        "kind": {
          "const": "image_folder",
          "title": "Kind",
          "type": "string"
        },
        "inputs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "classes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Classes",
          "type": "array"
        },
        "size": {
          "description": "height, width after resizing",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            },
            {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "title": "Size",
          "type": "array"
        },
        "grayscale": {
          "default": false,
          "title": "Grayscale",
          "type": "boolean"
        },
        "splits": {
          "$ref": "#/$defs/Splits"
        },
        "max_samples": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Samples"
        }
      },
      "required": [
        "kind",
        "inputs",
        "classes",
        "size",
        "splits"
      ],
      "title": "ImageFolder",
      "type": "object"
    },
    "ImagePairs": {
      "additionalProperties": false,
      "description": "Image/mask pairs (segmentation), one sample directory per case, across several inputs.",
      "properties": {
        "kind": {
          "const": "image_pairs",
          "title": "Kind",
          "type": "string"
        },
        "inputs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "samples": {
          "description": "glob of sample directories inside each input",
          "pattern": "^[A-Za-z0-9_.\\-*?\\[\\]][A-Za-z0-9_.\\-*?\\[\\]/]{0,254}$",
          "title": "Samples",
          "type": "string"
        },
        "image": {
          "description": "glob of the image file inside a sample directory",
          "pattern": "^[A-Za-z0-9_.\\-*?\\[\\]][A-Za-z0-9_.\\-*?\\[\\]/]{0,254}$",
          "title": "Image",
          "type": "string"
        },
        "mask": {
          "description": "glob of the mask file inside a sample directory",
          "pattern": "^[A-Za-z0-9_.\\-*?\\[\\]][A-Za-z0-9_.\\-*?\\[\\]/]{0,254}$",
          "title": "Mask",
          "type": "string"
        },
        "format": {
          "default": "png",
          "enum": [
            "png",
            "nifti"
          ],
          "title": "Format",
          "type": "string"
        },
        "mask_threshold": {
          "default": 0.0,
          "title": "Mask Threshold",
          "type": "number"
        },
        "skip_empty_masks": {
          "default": false,
          "title": "Skip Empty Masks",
          "type": "boolean"
        },
        "splits": {
          "$ref": "#/$defs/Splits"
        },
        "max_samples": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Samples"
        }
      },
      "required": [
        "kind",
        "inputs",
        "samples",
        "image",
        "mask",
        "splits"
      ],
      "title": "ImagePairs",
      "type": "object"
    },
    "JsonValue": {},
    "LossSpec": {
      "additionalProperties": false,
      "description": "Atomic loss (``class`` + ``params``) or an arithmetic ``expression`` over named components.",
      "properties": {
        "class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Params",
          "type": "object"
        },
        "expression": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "components": {
          "additionalProperties": {
            "$ref": "#/$defs/LossSpec"
          },
          "maxProperties": 16,
          "title": "Components",
          "type": "object"
        },
        "variables": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16,
          "title": "Variables",
          "type": "object"
        },
        "reduction": {
          "default": "mean",
          "enum": [
            "mean",
            "sum",
            "none"
          ],
          "title": "Reduction",
          "type": "string"
        }
      },
      "title": "LossSpec",
      "type": "object"
    },
    "OptimizerSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "OptimizerSpec",
      "type": "object"
    },
    "OutputTarget": {
      "additionalProperties": false,
      "description": "Where a step writes a model: a declared recipe output and its format.",
      "properties": {
        "output": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Output",
          "type": "string"
        },
        "format": {
          "enum": [
            "safetensors",
            "onnx",
            "xgboost-json",
            "xgboost-ubj",
            "skops",
            "keras"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "output",
        "format"
      ],
      "title": "OutputTarget",
      "type": "object"
    },
    "PrivacyShare": {
      "additionalProperties": false,
      "description": "Part of the recipe's DP budget assigned to one training step.",
      "properties": {
        "epsilon": {
          "exclusiveMinimum": 0,
          "title": "Epsilon",
          "type": "number"
        },
        "delta": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Delta",
          "type": "number"
        }
      },
      "required": [
        "epsilon",
        "delta"
      ],
      "title": "PrivacyShare",
      "type": "object"
    },
    "SchedulerSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "interval": {
          "default": "epoch",
          "enum": [
            "step",
            "epoch"
          ],
          "title": "Interval",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "SchedulerSpec",
      "type": "object"
    },
    "Splits": {
      "additionalProperties": false,
      "description": "Train/validation/test fractions (must sum to 1).",
      "properties": {
        "train": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Train",
          "type": "number"
        },
        "val": {
          "default": 0.0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Val",
          "type": "number"
        },
        "test": {
          "default": 0.0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Test",
          "type": "number"
        }
      },
      "required": [
        "train"
      ],
      "title": "Splits",
      "type": "object"
    },
    "TabularRef": {
      "additionalProperties": false,
      "description": "Feature matrices from a ``tabular/split`` step.",
      "properties": {
        "kind": {
          "const": "tabular",
          "title": "Kind",
          "type": "string"
        },
        "step": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "step"
      ],
      "title": "TabularRef",
      "type": "object"
    },
    "TensorFile": {
      "additionalProperties": false,
      "description": "Feature/target arrays stored in one safetensors or HDF5 file of an input dataset.",
      "properties": {
        "kind": {
          "const": "tensors",
          "title": "Kind",
          "type": "string"
        },
        "input": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Input",
          "type": "string"
        },
        "file": {
          "pattern": "^[A-Za-z0-9_.\\-*?\\[\\]][A-Za-z0-9_.\\-*?\\[\\]/]{0,254}$",
          "title": "File",
          "type": "string"
        },
        "format": {
          "enum": [
            "safetensors",
            "hdf5"
          ],
          "title": "Format",
          "type": "string"
        },
        "features_key": {
          "default": "features",
          "pattern": "^[A-Za-z0-9_./-]{1,128}$",
          "title": "Features Key",
          "type": "string"
        },
        "targets_key": {
          "default": "targets",
          "pattern": "^[A-Za-z0-9_./-]{1,128}$",
          "title": "Targets Key",
          "type": "string"
        },
        "splits": {
          "$ref": "#/$defs/Splits"
        },
        "max_samples": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Samples"
        }
      },
      "required": [
        "kind",
        "input",
        "file",
        "format",
        "splits"
      ],
      "title": "TensorFile",
      "type": "object"
    },
    "TrainingSpec": {
      "additionalProperties": false,
      "properties": {
        "epochs": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Epochs",
          "type": "integer"
        },
        "batch_size": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "optimizer": {
          "$ref": "#/$defs/OptimizerSpec"
        },
        "scheduler": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchedulerSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_grad_norm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "per-sample clipping norm (DP)",
          "title": "Max Grad Norm"
        }
      },
      "required": [
        "epochs",
        "batch_size",
        "optimizer"
      ],
      "title": "TrainingSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "discriminator": {
        "mapping": {
          "image_folder": "#/$defs/ImageFolder",
          "image_pairs": "#/$defs/ImagePairs",
          "tabular": "#/$defs/TabularRef",
          "tensors": "#/$defs/TensorFile"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TabularRef"
        },
        {
          "$ref": "#/$defs/TensorFile"
        },
        {
          "$ref": "#/$defs/ImagePairs"
        },
        {
          "$ref": "#/$defs/ImageFolder"
        }
      ],
      "title": "Data"
    },
    "task": {
      "enum": [
        "binary",
        "multiclass",
        "regression",
        "segmentation"
      ],
      "title": "Task",
      "type": "string"
    },
    "graph": {
      "$ref": "#/$defs/GraphRef"
    },
    "loss": {
      "anyOf": [
        {
          "$ref": "#/$defs/LossSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "loss_graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "graph mapping (prediction, target) to a scalar"
    },
    "training": {
      "$ref": "#/$defs/TrainingSpec"
    },
    "output_activation": {
      "default": "none",
      "enum": [
        "none",
        "sigmoid",
        "softmax"
      ],
      "title": "Output Activation",
      "type": "string"
    },
    "max_parameters": {
      "default": 200000000,
      "maximum": 2000000000,
      "minimum": 1,
      "title": "Max Parameters",
      "type": "integer"
    },
    "privacy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrivacyShare"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "save": {
      "$ref": "#/$defs/OutputTarget"
    },
    "seed": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    }
  },
  "required": [
    "data",
    "task",
    "graph",
    "training",
    "save"
  ],
  "title": "torch/graph-train@1 with",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-depa-plugin": {
    "name": "torch/graph-train",
    "version": "1.0.0",
    "tier": 2,
    "families": [
      "torch"
    ],
    "experimental": true
  }
}
