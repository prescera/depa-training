subscription_id = "00000000-0000-0000-0000-000000000000"
party_id        = "fintech-x"
name_prefix     = "fintechx-prod-cin"
location        = "centralindia"

admin_group_object_ids = ["11111111-1111-1111-1111-111111111111"]
job_submitters = [
  { object_id = "22222222-2222-2222-2222-222222222222", kind = "User" }, # CI service principal
]
api_server_authorized_ip_ranges = ["203.0.113.0/28"]

# DC endpoints (KMS/CS ACL ledger IPs and/or Application Gateway IPs) and any cross-cloud
# storage ranges the contracted datasets live in.
egress_https_destination_cidrs = ["198.51.100.10/32", "198.51.100.11/32"]

oidc_issuer_url             = "https://kms.dc.example.org/app/oidc"
output_storage_account_name = "fintechxprodcinout"

# Federation broker (spec §10.1; default while the KMS signs ES256 only).
# Build: ../../../modules/azure/federation-broker/build-package.sh  -> prints the zip path
broker_host_storage_account_name = "fintechxbrokerprod"
# Pinned KMS JWKS: curl -s https://kms.dc.example.org/app/oidc/jwks
kms_jwks_json = <<-EOT
  {"keys":[{"kty":"EC","crv":"P-256","kid":"<kid>","use":"sig","alg":"ES256","x":"<x>","y":"<y>"}]}
EOT
