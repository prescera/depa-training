project_id  = "fintechx-ccr-prod"
region      = "asia-south1"
party_id    = "fintech-x"
name_prefix = "fintechx-prod"

# DC endpoints (KMS/CS ACL ledger IPs and/or Application Gateway IPs) and any cross-cloud
# storage/STS ranges for the contracted datasets. Google APIs are allowed separately.
egress_https_destination_ranges = ["198.51.100.10/32", "198.51.100.11/32"]

job_submitter_members = ["serviceAccount:ccr-submitter@fintechx-ci.iam.gserviceaccount.com"]

oidc_issuer_url        = "https://kms.dc.example.org/app/oidc"
output_bucket_name     = "fintechx-prod-depa-outputs"
output_bucket_location = "ASIA-SOUTH1"

